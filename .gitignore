# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Node（dsh 插件运行环境：node_modules 指向 harness 的 junction，本机私有）
node_modules/

# 用户私有数据（聊天记录/图片/截图/密钥）一律不入库
data/seeds/chatlogs/*
data/seeds/images/*
data/seeds/screenshots/*
!data/seeds/chatlogs/.gitkeep
!data/seeds/images/.gitkeep
!data/seeds/screenshots/.gitkeep

# 生成产物与运行状态
data/output/*
data/review_center.db*
# 旧协作栈（已下线，保留文件仅作归档）
data/output/argilla.db*
!data/output/.gitkeep
data/workspaces/
# 文件夹注册表：机器私有（含本机绝对路径）＋并发锁，勿提交/手改
data/workspaces.json
data/workspaces.json.lock
# 打开文件夹内的生成产物（任何位置的 .dataforge/ 都不入库；也是只读枚举的排除项）
.dataforge/
*.log

# 密钥
.env
configs/backends.local.yaml
configs/backends.local.yaml.*.bak
PIP_CACHE_DIR=F:/无项目工作文件夹/tools/pip-cache
plugins/dsh-dataforge/cordis.yml
configs/review_remote.yaml

configs/review_remote.*.yaml
plugins/dsh-dataforge/team.yml
